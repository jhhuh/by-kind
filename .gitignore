# Build artifacts, never committed. The rule: text that DETERMINES the output is
# tracked (model/weights.*.tsv, data/taxonomy.yaml, data/legacy_mapping.yaml,
# data/fewshot.tsv) so changes are reviewable as diffs; everything DERIVED from
# it is rebuilt. categories.sqlite alone is 18 MB of binary that would add a
# fresh blob on every daily CI run.
data/packages*.jsonl
data/packages*.json
data/channels.json
data/*.br
data/categories.sqlite
data/categories.json
vendor/nixpkgs/

# Build / emit output
dist/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Nix / direnv
result
result-*
.direnv/

# Logs from test and pipeline runs (artifacts/devlog.md and skills/ ARE committed)
artifacts/logs/
