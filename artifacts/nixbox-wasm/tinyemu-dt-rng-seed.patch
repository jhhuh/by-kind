--- riscv_machine.c.pre_rng	2026-08-03 10:22:42.146607488 +0900
+++ riscv_machine.c	2026-08-03 10:22:29.719685474 +0900
@@ -38,6 +38,38 @@
 #include "virtio.h"
 #include "machine.h"
 
+/* Fill buf with host randomness for the device-tree rng-seed. Under
+   Emscripten getentropy() goes through random_get -> randomFill, which is
+   crypto.getRandomValues() in a browser and crypto.randomFillSync() under
+   node, so this works in the wasm build too -- verified by checking that
+   /dev/random does not block in the wasm guest. The /dev/urandom fallback
+   is dead there (NO_FILESYSTEM), and the last resort is not cryptographic;
+   it is only so a host missing both still boots to a seeded CRNG. */
+static void get_random_bytes_host(uint8_t *buf, int len)
+{
+    int i;
+    uint64_t x;
+    struct timespec ts;
+    FILE *f;
+
+    if (getentropy(buf, len) == 0)
+        return;
+    f = fopen("/dev/urandom", "rb");
+    if (f) {
+        size_t n = fread(buf, 1, len, f);
+        fclose(f);
+        if (n == (size_t)len)
+            return;
+    }
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    x = (uint64_t)ts.tv_sec * 1000000000ULL + ts.tv_nsec;
+    x ^= (uint64_t)(uintptr_t)buf * 0x9E3779B97F4A7C15ULL;
+    for(i = 0; i < len; i++) {
+        x ^= x << 13; x ^= x >> 7; x ^= x << 17;
+        buf[i] = (uint8_t)x;
+    }
+}
+
 /* RISCV machine */
 
 typedef struct RISCVMachine {
@@ -787,6 +819,20 @@
         fdt_prop_tab_u64(s, "linux,initrd-end", initrd_start + initrd_size);
     }
 
+    /* The machine has no entropy source of any kind: no virtio-rng, and
+       RISC-V has no unprivileged instruction the kernel could seed from.
+       Linux 5.x and later block getrandom() in wait_for_random_bytes()
+       until the CRNG is fully seeded, so on such a guest the first
+       getrandom() caller hangs forever -- glibc startup and qemu-user both
+       do this. Passing a seed here is the standard bootloader contract
+       (early_init_dt_scan_chosen reads it and credits it), and it is what
+       U-Boot and QEMU's own virt machine do. */
+    {
+        uint8_t seed[32];
+        get_random_bytes_host(seed, sizeof(seed));
+        fdt_prop(s, "rng-seed", seed, sizeof(seed));
+    }
+
     fdt_end_node(s); /* chosen */
     
     fdt_end_node(s); /* / */
