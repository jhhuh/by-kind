+/* Fill buf with host randomness for the device-tree rng-seed. Under
+   Emscripten getentropy() goes through random_get -> randomFill, which is
+   crypto.getRandomValues() in a browser and crypto.randomFillSync() under
+   node, so this works in the wasm build too -- verified by checking that
+   /dev/random does not block in the wasm guest. The /dev/urandom fallback
+   is dead there (NO_FILESYSTEM), and the last resort is not cryptographic;
+   it is only so a host missing both still boots to a seeded CRNG. */
+static void get_random_bytes_host(uint8_t *buf, int len)
+{
+    int i;
+    uint64_t x;
+    struct timespec ts;
+    FILE *f;
+
+    if (getentropy(buf, len) == 0)
+        return;
+    f = fopen("/dev/urandom", "rb");
+    if (f) {
+        size_t n = fread(buf, 1, len, f);
+        fclose(f);
+        if (n == (size_t)len)
+            return;
+    }
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    x = (uint64_t)ts.tv_sec * 1000000000ULL + ts.tv_nsec;
+    x ^= (uint64_t)(uintptr_t)buf * 0x9E3779B97F4A7C15ULL;
+    for(i = 0; i < len; i++) {
+        x ^= x << 13; x ^= x >> 7; x ^= x << 17;
+        buf[i] = (uint8_t)x;
+    }
+}
