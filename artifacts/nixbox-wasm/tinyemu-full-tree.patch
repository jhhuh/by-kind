+/* ---- PC sampling profiler ------------------------------------------
+   Samples the program counter every RISCV_PROF_STRIDE instructions into an
+   open-addressed table keyed on (pc, priv). Supervisor samples resolve
+   against the kernel's System.map; user samples are the workload. */
+#define RISCV_PROF_STRIDE 997
+#define RISCV_PROF_BITS   14
+#define RISCV_PROF_SIZE   (1 << RISCV_PROF_BITS)
+
+typedef struct {
+    uint64_t pc;
+    uint64_t count;
+    uint8_t priv;
+    uint8_t used;
+} RISCVProfEntry;
+
+static RISCVProfEntry riscv_prof_tab[RISCV_PROF_SIZE];
+static uint64_t riscv_prof_samples, riscv_prof_lost;
+
+static __attribute__((unused)) void riscv_prof_sample(uint64_t pc, int priv)
+{
+    uint64_t h = (pc * 0x9E3779B97F4A7C15ULL) >> (64 - RISCV_PROF_BITS);
+    int i;
+    riscv_prof_samples++;
+    for(i = 0; i < 64; i++) {
+        RISCVProfEntry *e = &riscv_prof_tab[(h + i) & (RISCV_PROF_SIZE - 1)];
+        if (!e->used) {
+            e->used = 1; e->pc = pc; e->priv = (uint8_t)priv; e->count = 1;
+            return;
+        }
+        if (e->pc == pc && e->priv == priv) { e->count++; return; }
+    }
+    riscv_prof_lost++;
+}
+
+static int riscv_prof_cmp(const void *a, const void *b)
+{
+    uint64_t ca = ((const RISCVProfEntry *)a)->count;
+    uint64_t cb = ((const RISCVProfEntry *)b)->count;
+    return (cb > ca) - (cb < ca);
+}
+
+static __attribute__((unused)) void riscv_prof_dump(void)
+{
+    static RISCVProfEntry snap[RISCV_PROF_SIZE];
+    uint64_t by_priv[4] = {0, 0, 0, 0};
+    uint64_t total = 0;
+    int i, n = 0;
+
+    for(i = 0; i < RISCV_PROF_SIZE; i++)
+        if (riscv_prof_tab[i].used) {
+            snap[n++] = riscv_prof_tab[i];
+            by_priv[riscv_prof_tab[i].priv & 3] += riscv_prof_tab[i].count;
+            total += riscv_prof_tab[i].count;
+        }
+    if (!total)
+        return;
+    qsort(snap, n, sizeof(snap[0]), riscv_prof_cmp);
+    fprintf(stderr, "PROF total=%llu U=%.1f%% S=%.1f%% M=%.1f%% distinct=%d lost=%llu\n",
+            (unsigned long long)total,
+            100.0 * by_priv[0] / total, 100.0 * by_priv[1] / total,
+            100.0 * by_priv[3] / total, n, (unsigned long long)riscv_prof_lost);
+    for(i = 0; i < n && i < 15; i++)
+        fprintf(stderr, "PROF   %5.1f%%  %c  0x%016llx\n",
+                100.0 * snap[i].count / total,
+                "US?M"[snap[i].priv & 3],
+                (unsigned long long)snap[i].pc);
+    memset(riscv_prof_tab, 0, sizeof(riscv_prof_tab));
+    riscv_prof_samples = riscv_prof_lost = 0;
+}
