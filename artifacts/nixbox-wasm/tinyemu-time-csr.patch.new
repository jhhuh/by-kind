--- riscv_cpu_priv.h.orig	2026-08-02 19:29:04.458520148 +0900
+++ riscv_cpu_priv.h	2026-08-02 21:59:50.633976656 +0900
@@ -235,6 +235,13 @@
 
     PhysMemoryMap *mem_map;
 
+    /* machine-supplied time source for the 'time' CSR, with a short cache:
+       the source is a host clock_gettime() and rdtime appears in hot loops */
+    uint64_t (*get_time)(void *opaque);
+    void *get_time_opaque;
+    uint64_t time_cache;
+    uint64_t time_cache_next;
+
     TLBEntry tlb_read[TLB_SIZE];
     TLBEntry tlb_write[TLB_SIZE];
     TLBEntry tlb_code[TLB_SIZE];
--- riscv_cpu.c.orig	2026-08-02 19:29:04.459520142 +0900
+++ riscv_cpu.c	2026-08-02 21:59:50.633976656 +0900
@@ -644,8 +644,29 @@
                       MSTATUS_FS | \
                       MSTATUS_MPRV | MSTATUS_SUM | MSTATUS_MXR)
 
-/* cycle and insn counters */
-#define COUNTEREN_MASK ((1 << 0) | (1 << 2))
+/* Read the machine's time source. Falls back to the instruction counter scaled
+   the same way riscv_machine.c's rtc_get_time() does when no source is set. */
+/* Refresh the cached time at most once every this many instructions. The Linux
+   riscv vDSO reads rdtime for every clock_gettime(), and the machine's time
+   source is a host syscall, so an uncached read costs a syscall per guest
+   instruction in hot paths — measured at ~100x slowdown running qemu-user.
+   The value stays monotonic because the underlying clock is, and a spin-wait
+   still makes progress because insn_counter advances. */
+#define TIME_CACHE_INSNS 1024
+
+static uint64_t glue(riscv_cpu_get_time, MAX_XLEN)(RISCVCPUState *s)
+{
+    if (!s->get_time)
+        return s->insn_counter / 16;
+    if (s->insn_counter >= s->time_cache_next) {
+        s->time_cache = s->get_time(s->get_time_opaque);
+        s->time_cache_next = s->insn_counter + TIME_CACHE_INSNS;
+    }
+    return s->time_cache;
+}
+
+/* cycle, time and insn counters (CY | TM | IR) */
+#define COUNTEREN_MASK ((1 << 0) | (1 << 1) | (1 << 2))
 
 /* return the complete mstatus with the SD bit */
 static target_ulong get_mstatus(RISCVCPUState *s, target_ulong mask)
@@ -743,6 +764,36 @@
         }
         val = (int64_t)s->insn_counter;
         break;
+    case 0xc01: /* time */
+        {
+            uint32_t counteren;
+            if (s->priv < PRV_M) {
+                if (s->priv < PRV_S)
+                    counteren = s->scounteren;
+                else
+                    counteren = s->mcounteren;
+                if (((counteren >> (csr & 0x1f)) & 1) == 0)
+                    goto invalid_csr;
+            }
+        }
+        val = (int64_t)glue(riscv_cpu_get_time, MAX_XLEN)(s);
+        break;
+    case 0xc81: /* timeh */
+        if (s->cur_xlen != 32)
+            goto invalid_csr;
+        {
+            uint32_t counteren;
+            if (s->priv < PRV_M) {
+                if (s->priv < PRV_S)
+                    counteren = s->scounteren;
+                else
+                    counteren = s->mcounteren;
+                if (((counteren >> (csr & 0x1f)) & 1) == 0)
+                    goto invalid_csr;
+            }
+        }
+        val = glue(riscv_cpu_get_time, MAX_XLEN)(s) >> 32;
+        break;
     case 0xc80: /* mcycleh */
     case 0xc82: /* minstreth */
         if (s->cur_xlen != 32)
@@ -1263,6 +1314,14 @@
     return s->insn_counter;
 }
 
+static void glue(riscv_cpu_set_get_time, MAX_XLEN)(RISCVCPUState *s,
+                                                   uint64_t (*get_time)(void *opaque),
+                                                   void *opaque)
+{
+    s->get_time = get_time;
+    s->get_time_opaque = opaque;
+}
+
 static void glue(riscv_cpu_set_mip, MAX_XLEN)(RISCVCPUState *s, uint32_t mask)
 {
     s->mip |= mask;
@@ -1343,6 +1402,7 @@
     glue(riscv_cpu_get_power_down, MAX_XLEN),
     glue(riscv_cpu_get_misa, MAX_XLEN),
     glue(riscv_cpu_flush_tlb_write_range_ram, MAX_XLEN),
+    glue(riscv_cpu_set_get_time, MAX_XLEN),
 };
 
